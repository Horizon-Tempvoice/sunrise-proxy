{
  "title": "Sunrise",
  "uid": "sunrise",
  "editable": true,
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "graphTooltip": 1,
  "tags": [
    "sunrise",
    "discord"
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "bot",
        "label": "Bot",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(sunrise_requests_seconds_count, bot)",
          "refId": "bot"
        },
        "definition": "label_values(sunrise_requests_seconds_count, bot)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "refresh": 2
      },
      {
        "name": "instance",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(sunrise_build_info, instance)",
          "refId": "instance"
        },
        "definition": "label_values(sunrise_build_info, instance)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "429s from Discord in the last hour",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(sunrise_requests_seconds_count{instance=~\"$instance\",bot=~\"$bot\",status=\"429\"}[1h]))",
          "refId": "A"
        }
      ],
      "timeFrom": "1h"
    },
    {
      "type": "stat",
      "title": "Requests to Discord per second now",
