      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
